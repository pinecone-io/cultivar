# Copy this file to .env and fill in the values you need. Auto-loaded by
# cultivar at startup (via python-dotenv). .env is gitignored; .env.example
# is checked in.

# --- Required for grading (always runs locally, regardless of --remote) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: for tasks that need a Pinecone API key ---
PINECONE_API_KEY=pcsk_...

# --- Optional: per-runner local auth ---
# Gemini CLI (or OAuth via `gemini auth`)
GEMINI_API_KEY=AIza...

# GitHub Copilot CLI — must be a fine-grained PAT with "Copilot Requests" permission.
COPILOT_GITHUB_TOKEN=ghp_...

# --- Optional: Modal workspace selection for --remote ---
# If you belong to multiple Modal workspaces (e.g. personal + team), pin the
# one cultivar --remote should use. Otherwise Modal picks whatever profile
# is active per ~/.modal.toml.
# MODAL_PROFILE=my-team-workspace
